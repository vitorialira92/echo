  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const baseUrl = pm.collectionVariables.get(\"baseUrl\");",
          "",
          "function ensureToken(tokenVar, userVar, passVar) {",
          "    if (pm.collectionVariables.get(tokenVar)) { return; }",
          "    pm.sendRequest({",
          "        url: baseUrl + \"/api/auth/login\",",
          "        method: \"POST\",",
          "        header: { \"Content-Type\": \"application/json\" },",
          "        body: { mode: \"raw\", raw: JSON.stringify({",
          "            username: pm.collectionVariables.get(userVar),",
          "            password: pm.collectionVariables.get(passVar)",
          "        }) }",
          "    }, function (err, res) {",
          "        if (!err && res && res.code === 200) {",
          "            pm.collectionVariables.set(tokenVar, res.json().token);",
          "        }",
          "    });",
          "}",
          "",
          "ensureToken(\"adminToken\", \"adminUser\", \"adminPass\");",
          "ensureToken(\"userToken\", \"userUser\", \"userPass\");"
        ]
      }
    }
  ]
