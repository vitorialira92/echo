  "item": [
    {
      "name": "0. Autenticacao",
      "description": "Login por usuario e senha em POST /api/auth/login. A resposta traz o token JWT, que e guardado em {{adminToken}} e {{userToken}} e reutilizado como 'Authorization: Bearer' nas demais requisicoes. Rode esta pasta primeiro.",
      "item": [
        {
          "name": "Login (admin)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUser}}\",\n  \"password\": \"{{adminPass}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Autentica o admin (perfil ADMIN) e guarda o JWT em {{adminToken}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set(\"adminToken\", json.token);",
                  "pm.test(\"recebeu token JWT\", function () {",
                  "    pm.expect(json.token, \"token\").to.be.a(\"string\").and.to.have.length.above(0);",
                  "    pm.expect(json.tokenType).to.eql(\"Bearer\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (usuario luna)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{userUser}}\",\n  \"password\": \"{{userPass}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Autentica luna (perfil USER) e guarda o JWT em {{userToken}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set(\"userToken\", json.token);",
                  "pm.test(\"recebeu token JWT\", function () {",
                  "    pm.expect(json.token, \"token\").to.be.a(\"string\").and.to.have.length.above(0);",
                  "    pm.expect(json.tokenType).to.eql(\"Bearer\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
