    {
      "name": "5. Avaliacoes",
      "description": "A avaliacao e sempre do usuario autenticado. Esta pasta autentica como luna (USER) por padrao. A media e publica.",
      "auth": {
        "type": "basic",
        "basic": [
          {
            "key": "username",
            "value": "{{userUser}}",
            "type": "string"
          },
          {
            "key": "password",
            "value": "{{userPass}}",
            "type": "string"
          }
        ]
      },
      "item": [
