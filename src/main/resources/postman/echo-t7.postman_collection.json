          "name": "Registrar avaliacao",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ratings/{{songId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
