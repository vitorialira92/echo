            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 9,\n  \"feeling\": \"EXCITED\",\n  \"review\": \"Avaliacao de teste via Postman.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Cria a avaliacao da luna para {{songId}}. Uma segunda tentativa daria 409."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", function () { pm.response.to.have.status(201); });"
