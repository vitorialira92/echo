  "item": [
    {
      "name": "1. Artistas",
      "description": "CRUD de artistas (R1). Leituras sao publicas; escrita exige ADMIN.",
      "item": [
        {
          "name": "Criar artista",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/artists",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "artists"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tame Impala\",\n  \"country\": \"AU\",\n  \"imageUrl\": \"https://example.com/img/tame-impala.jpg\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Cria um artista (ADMIN). O id retornado e guardado em {{artistId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set(\"artistId\", json.id);",
                  "pm.test(\"retornou id\", function () { pm.expect(json.id).to.exist; });"
                ]
              }
            }
          ]
        },
