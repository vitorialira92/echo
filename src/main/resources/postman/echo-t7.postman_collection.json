            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{apiUsername}}\",\n  \"password\": \"apiuser123\",\n  \"name\": \"Usuario de Teste API\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Sem role, a conta nasce como USER (R5). O id vai para {{userId}}."
